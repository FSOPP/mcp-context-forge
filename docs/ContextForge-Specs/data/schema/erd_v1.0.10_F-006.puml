@startuml erd_v1.0.10_F-006
' F-006 — LLM Gateway and Chat. Subset of erd_master; introduces nothing new.
hide circle
skinparam linetype ortho

entity "llm_providers" as llm_providers {
  * id : String <<PK>>
  --
  * name : String
  * slug : String
    description : Text
  * provider_type : String
    api_key : Text
    api_base : String
    api_version : String
  * config : JSON
    default_model : String
  * default_temperature : Float
    default_max_tokens : Integer
  * enabled : Boolean
  * health_status : String
    last_health_check : DateTime
  * plugin_ids : JSON
  * created_at : DateTime
  * updated_at : DateTime
    created_by : String
    modified_by : String
}

entity "llm_models" as llm_models {
  * id : String <<PK>>
  --
  * provider_id : String <<FK>>
  * model_id : String
  * model_name : String
    model_alias : String
    description : Text
  * supports_chat : Boolean
  * supports_streaming : Boolean
  * supports_function_calling : Boolean
  * supports_vision : Boolean
    context_window : Integer
    max_output_tokens : Integer
  * enabled : Boolean
  * deprecated : Boolean
  * created_at : DateTime
  * updated_at : DateTime
}

' relationships (declared ForeignKey targets only)
llm_providers ||--o{ llm_models : provider_id
@enduml
